POSTGRES_USER=midigator
POSTGRES_PASSWORD=midigator
POSTGRES_DB=midigator
APP_PORT=8080

# Signing key for JWT access tokens (override in production)
JWT_SECRET=dev-insecure-change-me
JWT_TTL_MINUTES=120

# Redis (asynq queue + rights cache)
REDIS_ADDR=redis:6379

# Inbound Midigator webhook HTTP Basic auth (per the original app)
MIDIGATOR_WEBHOOK_USERNAME=midigator
MIDIGATOR_WEBHOOK_PASSWORD=webhook-secret
